{
  "name": "jagate",
  "type": "module",
  "version": "0.1.0",
  "description": "A small self-hosted human approval gateway",
  "license": "MIT",
  "homepage": "https://ahmetomerv.github.io/JaGate/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmetomerv/JaGate.git"
  },
  "bugs": "https://github.com/ahmetomerv/JaGate/issues",
  "keywords": [
    "approval",
    "gateway",
    "telegram",
    "human-in-the-loop",
    "self-hosted"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/client.d.ts",
      "default": "./dist/src/client.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "assets",
    "dist"
  ],
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node dist/src/main.js",
    "start:local": "node --env-file=.env dist/src/main.js",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && cp -R migrations dist/migrations",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p console/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage test/*.test.ts",
    "demo:fake": "node --import tsx examples/fake-flow.ts",
    "playground": "node --import tsx playground/main.ts",
    "playground:build": "vite build --config playground/vite.config.ts",
    "console:dev": "vite --config console/vite.config.ts",
    "console:build": "vite build --config console/vite.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "verify": "npm run typecheck && npm test && npm run lint && npm run build && npm run console:build && npm run docs:build && npm run playground:build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "13.0.3",
    "fastify": "^5.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "5.2.4",
    "element-plus": "^2.14.7",
    "eslint": "^9.0.0",
    "eslint-plugin-format": "^2.0.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "5.4.21",
    "vitepress": "^1.6.4",
    "vue": "3.5.43",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.13"
  }
}
